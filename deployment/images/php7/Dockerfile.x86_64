ARG PUID
ARG GUID
ARG HTDOCS

FROM php:7.4.33-fpm-alpine3.15

ENV HTDOCS ${HTDOCS:-"/usr/local/apache2/htdocs"}
ENV PUID ${PUID:-1000}
ENV GUID ${GUID:-1000}

WORKDIR ${HTDOCS}

# Use the default production configuration
RUN mv "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini"

RUN apk update \
    && apk add --no-cache \
    python3 \
    bash \
    git \
    zip \
    unzip \
    mariadb-client

RUN apk del build-base \
    && rm -rf /var/cache/apk/*

COPY php-ini-overrides.ini /etc/php/7.4.33/fpm/conf.d/99-overrides.ini

# Enable PHP extensions
COPY --from=mlocati/php-extension-installer /usr/bin/install-php-extensions /usr/local/bin/

RUN install-php-extensions \
    curl \
    dom \
    ext-intl \
    gd \
    intl \
    json \
    mbstring \
    mysqli \
    mysqlnd \
    odbc \
    opcache \
    openssl \
    pcntl \
    phar \
    pdo_mysql \
    simplexml \
    sodium \
    tokenizer \
    xmlwriter \
    zlib \
    xml

# Install composer
RUN curl -sS https://getcomposer.org/installer | php -- --install-dir=/usr/bin/ --filename=composer

# php-fpm configuration install
COPY etc/php-fpm.d /etc/php-fpm.d
