version: 3.9

x-bake:
  targets:
    db:
      # Buildx multi‑arch metadata
      platforms:
        - linux/amd64
      tags: 
        - ${DOCKER_USER}/mysqldb:latest
        - ${DOCKER_USER}/mysqldb:${BAKE_TAG}
      build:
        context: deployment/images/mysqldb
        dockerfile: Dockerfile.x86_64
        args:
          PUID: 1000
          PGID: 1000
    php-fpm:
      # Buildx multi‑arch metadata
      platforms:
        - linux/amd64
      tags:
        - ${DOCKER_USER}/php-fpm:latest
        - ${DOCKER_USER}/php-fpm:${BAKE_TAG}
      build:
        context: .
        dockerfile: Dockerfile.x86_64
        args:
          PUID: 1000
          PGID: 1000
          MYPHPCMS_DIR: app/webroot/php-cms
          MYPHPCMS_LOG: app/tmp/logs
          HTDOCS: /var/www/html
    httpd:
      # Buildx multi‑arch metadata
      platforms:
        - linux/amd64
      tags:
        - ${DOCKER_USER}/httpd:latest
        - ${DOCKER_USER}/httpd:${BAKE_TAG}
      build:
        context: deployment/images/httpd
        dockerfile: Dockerfile.x86_64
        args:
          PUID: 1000
          PGID: 1000
          HTDOCS: /var/www/html
    balena-storage:
      # Buildx multi‑arch metadata
      platforms:
        - linux/amd64
      tags:
        - ${DOCKER_USER}/balena-storage:latest
        - ${DOCKER_USER}/balena-storage:${BAKE_TAG}
      build:
        context: balena-storage
        dockerfile: Dockerfile.x86_64

services:
  db:
    image: betothreeprod/mysqldb:latest
    environment:
      MYSQL_RANDOM_ROOT_PASSWORD: yes
      TZ: Europe/Paris
    volumes:
      - localtime:/etc/localtime:ro
      - db-data:/config
      - db-socket:/var/run/mysqld
    ports:
      - "3306:3306"
    restart: unless-stopped
    networks:
      - cake
    env_file:
      - common.env
      - x86_64.env
    labels:
      io.balena.features.dbus: "1"
  php-fpm:
    image: betothreeprod/php-fpm:latest
    env_file:
      - common.env
      - x86_64.env
    environment:
      CAKEPHP_DEBUG_LEVEL: "2"
      COLLECT_COVERAGE: false
      CAKEPHP_SECURITY_SALT: Word
      CAKEPHP_SECURITY_CIPHER_SEED: 01234
    volumes:
      - localtime:/etc/localtime:ro
      - www:/var/www/html
      - php-fpm:/usr/local/etc
    ports:
      - "9001:9001"
    networks:
      - cake
  httpd:
    image: betothreeprod/httpd:latest
    env_file:
      - common.env
      - x86_64.env
    volumes:
      - localtime:/etc/localtime:ro
      - www:/var/www/html
      - apache2:/usr/local/apache2
    ports:
      - "80:80"
      - "443:443"
    networks:
      - cake
  balena-storage:
    image: betothreeprod/balena-storage:latest
    privileged: true
    env_file:
      - common.env
      - x86_64.env
    networks:
      - cake
#    healthcheck:
#      test: ["CMD", "/usr/src/scripts/backup-db.sh"]
#      interval: 720h
#      timeout: 10s
#      retries: 3
#      start_period: 30m
    volumes:
      - db-backup:/mnt/external-drives
volumes:
  www:
  php-fpm:
  apache2:
  hostapcache:
  db-data:
  db-socket:
  config:
  localtime:
  db-backup:
networks:
  cake:
    external: false