version: "2.1"
services:
  db:
    build:
      context: deployment/images/mysqldb
      dockerfile: Dockerfile.%%BALENA_ARCH%%
      args:
        PUID: 0
        PGID: 0
    environment:
      MYSQL_RANDOM_ROOT_PASSWORD: yes
    volumes:
      - localtime:/etc/localtime:ro
      - db-data:/config
      - db-socket:/var/run/mysqld
      - app:/var/www/htdocs/localhost/app
    ports:
      - "3306:3306"
    restart: unless-stopped
    networks:
      - cake
    env_file:
      - common.env
      - .env
    labels:
      io.balena.features.dbus: "1"
  php-fpm:
    env_file:
      - common.env
      - .env
    build:
      context: .
      dockerfile: deployment/images/php7/Dockerfile.%%BALENA_ARCH%%
    volumes:
      - localtime:/etc/localtime:ro
      - app:/var/www/htdocs/localhost/app
    ports:
      - "80:80"
      - "443:443"
    networks:
      - cake
  apache:
    env_file:
      - common.env
      - .env
    build:
      context: .
      dockerfile: Dockerfile.%%BALENA_ARCH%%
      args:
        CAKEPHP_DEBUG_LEVEL: "2"
        PUID: 1000
        PGID: 1000
    volumes:
      - localtime:/etc/localtime:ro
      - app:/var/www/htdocs/localhost/app
    ports:
      - "80:80"
      - "443:443"
    networks:
      - cake
  balena-storage:
    build:
      context: balena-storage
      dockerfile: Dockerfile.%%BALENA_ARCH%%
    privileged: true
    env_file:
      - common.env
      - .env
    networks:
      - cake
# v3.4 compose file
#    healthcheck:
#      test: ["CMD", "/usr/src/scripts/backup-db.sh"]
#      interval: 720h
#      timeout: 10s
#      retries: 3
#      start_period: 30m
    volumes:
      - db-backup:/mnt/external-drives
volumes:
  app:
  hostapcache:
  db-data:
  db-socket:
  config:
  localtime:
  db-backup:
networks:
  cake:
    external: false
