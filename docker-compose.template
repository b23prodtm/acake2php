version: "2.1"
services:
  db:
    build:
      context: deployment/images/mysqldb
      dockerfile: Dockerfile.%%BALENA_ARCH%%
      args:
        PUID: 1000
        PGID: 1000
    environment:
      MYSQL_RANDOM_ROOT_PASSWORD: yes
			TZ: Europe/Paris
    volumes:
      - localtime:/etc/localtime:ro
      - db-data:/config
      - db-socket:/var/run/mysqld
    ports:
      - "3306:3306"
    restart: unless-stopped
    networks:
      - cake
    env_file:
      - common.env
      - %%BALENA_ARCH%%
    labels:
      io.balena.features.dbus: "1"
  php-fpm:
    env_file:
      - common.env
      - %%BALENA_ARCH%%.env
    build:
      context: .
      dockerfile: Dockerfile.%%BALENA_ARCH%%
      args:
        PUID: 1000
        PGID: 1000
    env_file:
      - common.env
      - %%BALENA_ARCH%%.env
    environment:
      CAKEPHP_DEBUG_LEVEL: "2"
   		COLLECT_COVERAGE: false
			TZ: Europe/Paris
			CAKEPHP_SECURITY_SALT: Word
			CAKEPHP_SECURITY_CIPHER_SEED: 01234
			MYPHPCMS_DIR: app/webroot/php-cms
			MYPHPCMS_LOG: app/tmp/logs
			HTDOCS: /var/wwww
    volumes:
      - localtime:/etc/localtime:ro
    ports:
      - "9001:9001"
      - "9002:9002"
    networks:
      - cake
  apache:
    env_file:
      - common.env
      - %%BALENA_ARCH%%.env
    environment:
			TZ: Europe/Paris
			HTDOCS: /var/www
    build:
      context: deployment/images/httpd
      dockerfile: Dockerfile.%%BALENA_ARCH%%
      args:
        PUID: 1000
        PGID: 1000
    volumes:
      - localtime:/etc/localtime:ro
      - htdocs:%%HTDOCS%%
    ports:
      - "80:80"
      - "443:443"
    networks:
      - cake
  balena-storage:
    build:
      context: balena-storage
      dockerfile: Dockerfile.%%BALENA_ARCH%%
    privileged: true
    env_file:
      - common.env
      - %%BALENA_ARCH%%.env
    networks:
      - cake
# v3.4 compose file
#    healthcheck:
#      test: ["CMD", "/usr/src/scripts/backup-db.sh"]
#      interval: 720h
#      timeout: 10s
#      retries: 3
#      start_period: 30m
    volumes:
      - db-backup:/mnt/external-drives
volumes:
  app:
  hostapcache:
  db-data:
  db-socket:
  config:
  localtime:
  db-backup:
networks:
  cake:
    external: false
